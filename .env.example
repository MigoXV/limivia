LIMIVIA_TRANSPORT=usb
# 多台设备时填写扫描得到的完整 ID；留空时请删除此变量，不要设置为空字符串。
# LIMIVIA_TARGET=/dev/ttyACM0
# 网络连接不扫描，显式指定URL；MQTT还必须指定目标MAC。
# LIMIVIA_TARGET=ws://192.168.1.20/v3
# LIMIVIA_DEVICE_ID=aa:bb:cc:dd:ee:ff
# LIMIVIA_MQTT_USERNAME=your-user
# LIMIVIA_MQTT_PASSWORD=your-password
# LIMIVIA_CA_FILE=/path/to/ca.pem
# LIMIVIA_CERT_FILE=/path/to/client.pem
# LIMIVIA_KEY_FILE=/path/to/client.key
# 终端CLI读取shell环境；VS Code通过envFile读取复制后的.env。
