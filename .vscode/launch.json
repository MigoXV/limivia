{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LIMIVIA SDK 扫描",
      "type": "debugpy",
      "request": "launch",
      "module": "limivia.commands.app",
      "args": [
        "scan",
        "--kind",
        "usb"
      ],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "LIMIVIA SDK ADC 示例",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.peripherals.async_adc",
      "args": [
        "--samples",
        "10"
      ],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "LIMIVIA SDK 同步状态示例",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.device.sync_state",
      "args": [],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "LIMIVIA SDK 异步状态示例",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.device.async_state",
      "args": [],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "LIMIVIA SDK PWM 示例",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.peripherals.sync_pwm",
      "args": [
        "--duration",
        "5"
      ],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "LIMIVIA SDK 事件订阅示例",
      "type": "debugpy",
      "request": "launch",
      "module": "examples.device.async_events",
      "args": [
        "--duration",
        "10"
      ],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
